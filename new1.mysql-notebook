    "content": "USE student;use student;\nSELECT dept, COUNT(*) total FROM student2 GROUP by dept HAVING (total)> 2;\nSELECT dept, AVG(roll) AS average FROM student2 GROUP by dept HAVING (average) > 61;\nSELECT * FROM student2 WHERE roll = 60;\nUPDATE student2 \nSET dept = 'MCA' \nwhere roll = 60;\nSELECT * FROM student2 WHERE roll = 60;\nUPDATE student2 SET roll = 65\nWHERE roll = 61;\nSELECT * FROM student2 WHERE roll = 65;\nUPDATE student2\nSET dept = 'CSE'\nWHERE name = 'Rohit';\nSELECT * FROM student2;\nUPDATE student2\nSET roll = 70, \n    dept = 'CSE'\nwhere name = 'anjali';\nSELECT * FROM student2;\nDELETE FROM student2 \nWHERE name = 'shripada';\nSELECT * FROM student2;\nDELETE FROM student2 \nWHERE roll = 70;\nUSE student;\nDELETE FROM student2\nWHERE name = 'rohit';\nSELECT * FROM student2;\nDELETE FROM student2\nWHERE dept = 'cse';\nSELECT * FROM student2;\nDELETE FROM student2\nWHERE roll > 62;\nSELECT * FROM student2;\nUPDATE student2\nSET dept = 'MBA'\nWHERE name = 'hiran';\nSELECT * FROM student2;\nuse student;\nUPDATE student2\nSET dept = 'BCA'\nWHERE name = 'karan';\nSELECT * FROM student2;\nINSERT INTO student2\nVALUES('karan',85,'BCA');\nUPDATE student2\nSET roll = 75\nWHERE name = 'karan';\nUPDATE student2\nSET \n    roll = 80,\n    dept = 'MCA'\nWHERE name = 'karan';\nSELECT * FROM student2;\nDELETE FROM student2\nWHERE name = 'hiran';\nSELECT * FROM student2;\nUSE student;\nSELECT name, roll,\nCASE\nWHEN roll >= 65 THEN 'qualified'\nELSE 'not qualified'\nEND as result FROM student2 WHERE dept IN ('bca','mca');\nSELECT name, dept, roll,\nCASE \nWHEN roll >= 75 THEN 'excellent'\nWHEN roll >= 65 THEN 'good'\nELSE 'average'\nEND as performance FROM student2 WHERE dept in ('bca','mca','cse')\nORDER BY roll DESC;\nSELECT roll,\nCASE \nWHEN roll >= 70 THEN 'high'\nWHEN roll >= 60 THEN 'medium'\nELSE 'low'\nEND as status FROM student2;",
